// ============================================
// Inforsion Server - 테스트용 Jenkins 파이프라인
// ============================================
//
// 목적: Jenkins가 정상 작동하는지 확인
// 사용법: Jenkins에서 Pipeline Job 생성 후 이 파일 사용
//

pipeline {
    agent any

    stages {
        stage('👋 Welcome') {
            steps {
                echo '============================================'
                echo '   Inforsion Server - Jenkins 테스트'
                echo '============================================'
                echo ''
                echo '현재 작업 디렉토리: ${WORKSPACE}'
                echo '빌드 번호: ${BUILD_NUMBER}'
                echo '브랜치: ${GIT_BRANCH}'
            }
        }

        stage('🔍 Environment Check') {
            steps {
                echo '환경 확인 중...'
                sh '''
                    echo "=== Java 버전 ==="
                    java -version

                    echo ""
                    echo "=== Docker 버전 ==="
                    docker --version

                    echo ""
                    echo "=== Docker Compose 버전 ==="
                    docker-compose --version

                    echo ""
                    echo "=== Gradle 버전 ==="
                    cd /workspace
                    chmod +x gradlew
                    ./gradlew --version

                    echo ""
                    echo "=== 작업 디렉토리 내용 ==="
                    ls -la
                '''
            }
        }

        stage('📦 Simple Test') {
            steps {
                echo '간단한 Gradle 명령어 테스트...'
                sh '''
                    cd /workspace
                    ./gradlew clean
                    echo "✅ Gradle 명령어 정상 작동!"
                '''
            }
        }

        stage('🐳 Docker Test') {
            steps {
                echo 'Docker 명령어 테스트...'
                sh '''
                    docker ps
                    echo "✅ Docker 명령어 정상 작동!"
                '''
            }
        }
    }

    post {
        success {
            echo ''
            echo '✅ =========================================='
            echo '✅  테스트 파이프라인 성공!'
            echo '✅ =========================================='
            echo ''
            echo '다음 단계:'
            echo '  1. Jenkinsfile (실제 파이프라인) 작성'
            echo '  2. Docker Hub Credentials 등록'
            echo '  3. 실제 빌드 실행'
            echo ''
        }
        failure {
            echo ''
            echo '❌ =========================================='
            echo '❌  테스트 파이프라인 실패!'
            echo '❌ =========================================='
            echo ''
            echo '확인사항:'
            echo '  - Docker가 실행 중인가?'
            echo '  - Gradle wrapper가 있는가?'
            echo '  - 권한 문제는 없는가?'
            echo ''
        }
        always {
            echo '빌드 완료 시각: ' + new Date().toString()
        }
    }
}